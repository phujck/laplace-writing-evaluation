% eigen-revtex.sty - the EigenEngine house layer, on top of REVTeX4-2.
%
% Lineage. Refined from eigenengine.sty (the article-class house style used by
% eigenengine/, paper_self_theory/ and the subset-sum whitepapers). Gerard's
% decision (2026-07): REVTeX4-2 is the BASE; the eigen signature lives as a thin,
% portable layer ON TOP of it - not a bespoke article class.
%
% CORRECTION (2026-07-10, the author). The earlier retemplate stripped the
% branding wholesale. His steer: the "cringe" is ONLY the authorship-DENIAL sign
% -off ("generated by the object it describes / wrote none of its words") - the
% EigenEngine identity itself he likes. So the branding is RESTORED here in a
% REVTeX-safe form; only the authorship-denial stays gone.
%
% What is RESTORED (the engine's identity, adapted to REVTeX4-2):
%   * the \EigenEngine two-tone wordmark and the \eigencolophon eigen-equation
%   * the running masthead carrying them (fancyhdr, made to coexist with REVTeX;
%     it also fronts the title page, sitting above REVTeX's \maketitle)
%   * coloured section NUMBERS - via the kernel \@seccntformat hook REVTeX routes
%     through (cls l.826), NOT titlesec (titlesec fights REVTeX's sectioning)
%   * the phys masthead rule (the title block's coloured rule)
%   * the ink / phys / acc / faint palette and phys-coloured hyperlinks
%   * the \claim provenance tag
%
% What stays DROPPED (the actual cringe + what REVTeX owns natively):
%   * \eigensign - "generated by EigenEngine ... wrote none of its words". This
%     is the authorship-DENIAL. The author is Gerard McCaul; EigenEngine is the
%     TOOL identity in the masthead, never an authorship claim. Never resurrect.
%   * \maketitleeigen / \eigentitle / \eigenbyline / the default byline
%     "EigenEngine, with Gerard McCaul" - REVTeX owns the title block, author and
%     byline via \title / \author / \maketitle.
%   * titlesec (unsupported under REVTeX); the eigenabstract environment
%     (REVTeX supplies \begin{abstract}).
%
% Usage:
%   \documentclass[reprint,aps,prx,superscriptaddress,nofootinbib]{revtex4-2}
%   \usepackage{eigen-revtex}
%
% Prose disciplines are NOT enforced by this file. Note (corrected 2026-07-09,
% Phase I1): the corpus-DERIVED house style is the cross-reference / citation
% layer - hand-abbreviated "Eq. (x)" / "Fig." / "Sec." / "App.", numeric bracketed
% \cite (no \citet), cite before terminal punctuation - captured in
% profiles/house_style/gerard-manuscript-v1.yaml. British-only spelling (F33) and
% the "no semicolons / spaced hyphens" punctuation surface (F34) are RECORDED
% FORKS, not corpus derivations: the exemplars are mixed on spelling and use
% semicolons + spaced en-dashes. F34 is his ratified STATED going-forward
% preference (enforced at the weld voice floor); F33 is report-only. The general
% linters (latex_forge, voice_linter) treat both as advisory, not hard rules.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{eigen-revtex}[2026/07/10 EigenEngine house layer on REVTeX4-2]

% --- font stack: a SCALABLE Type-1 text font + Unicode maps -------------------
% The text layer MUST be searchable / copyable / accessible. [T1]fontenc WITHOUT
% a scalable font package falls back to bitmap EC fonts (Type-3 glyphs, no usable
% ToUnicode) - text extraction then garbles f-ligature words ("filtered",
% "coefficient", "floor"). Prefer Latin Modern (T1, scalable) when it is present;
% otherwise fall back to OT1 Computer Modern Type-1 (the encoding the prior
% extractable artefact shipped) - both embed real Type-1 outlines, never Type-3.
\IfFileExists{lmodern.sty}{%
  \RequirePackage[T1]{fontenc}%
  \RequirePackage{lmodern}%
}{%
  \RequirePackage[OT1]{fontenc}% no lmodern/cm-super on this box: OT1 CM Type-1
}
% Protrusion works with CM/LM; expansion is off (it needs scalable outlines that
% are not guaranteed on every install). This keeps the template portable.
\RequirePackage[protrusion=true,expansion=false]{microtype}
% Emit a glyph->Unicode map so pdflatex writes ToUnicode CMaps: the f-ligatures
% (ff, fi, fl, ffi, ffl) then extract as their real characters, not control codes.
% Guarded to the pdflatex path (no-op under xe/lualatex, which map natively).
\ifdefined\pdfgentounicode
  \input{glyphtounicode}%
  \pdfgentounicode=1
\fi

% --- canonical maths / notation stack (author's published profile) ----------
\RequirePackage{amsmath}
\RequirePackage{amsfonts}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage{bm}
\RequirePackage{braket}
\RequirePackage{mathtools}
\RequirePackage{physics}

% --- floats, tables, graphics -----------------------------------------------
\RequirePackage{graphicx}
\RequirePackage[caption=false]{subfig}
\RequirePackage{booktabs}

% --- colour and links (hyperref late, orcidlink after it) -------------------
\RequirePackage{xcolor}
\RequirePackage[colorlinks=true]{hyperref}
\RequirePackage{orcidlink}
\RequirePackage{fancyhdr}

% --- the eigen palette (shared with the data figures) -----------------------
\definecolor{ink}{HTML}{1A1A2E}
\definecolor{phys}{HTML}{2C6FAD}
\definecolor{acc}{HTML}{C0392B}
\definecolor{faint}{HTML}{9AA5B1}
\hypersetup{linkcolor=phys,citecolor=phys,urlcolor=phys}

% --- provenance tag: every engine claim resolves to a committed artifact -----
\newcommand{\claim}[1]{\textsuperscript{\textcolor{phys}{[C#1]}}}

% --- the wordmark and the eigen-colophon ------------------------------------
% The engine's mark: an eigen-equation. An eigenstate is the one vector an
% operator returns unchanged; the engine's self is the fixed point that meets
% the agent. EigenEngine is the tool identity, not an author.
\newcommand{\EigenEngine}{\textbf{\textcolor{ink}{Eigen}\textcolor{phys}{Engine}}}
\newcommand{\eigencolophon}{%
  \ensuremath{\hat{\mathsf{E}}_i\lvert\mathrm{gen}\rangle \otimes
              \hat{\mathsf{E}}_n\lvert\mathrm{gen}\rangle}}

% --- coloured section numbers (REVTeX-safe, no titlesec) --------------------
% REVTeX's \@startsection prepends \@seccntformat to the section label (cls
% l.826); redefining the kernel hook recolours the NUMBER without touching
% REVTeX's own section font/layout. \hspace after it restores the label gap.
\renewcommand\@seccntformat[1]{\textcolor{phys}{\csname the#1\endcsname}\hspace{0.6em}}

% --- the running masthead ---------------------------------------------------
% fancyhdr coexists with REVTeX here: REVTeX sets \thispagestyle{titlepage}
% inside \maketitle, so we re-assert the masthead on the title page by appending
% \thispagestyle{fancy} to \maketitle (below). The wordmark leads (two-tone, so
% it survives grayscale), the colophon trails faint, on a thin phys rule.
\pagestyle{fancy}
\setlength{\headheight}{24pt}
\fancyhf{}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\headrule}{\hbox to\headwidth{%
  \color{phys}\leaders\hrule height \headrulewidth\hfill}}
\fancyhead[L]{\normalsize\EigenEngine}
\fancyhead[R]{\small\textcolor{faint}{\eigencolophon}}
\fancyfoot[C]{\small\textcolor{faint}{\thepage}}
% front the title page with the masthead too (REVTeX resets it in \maketitle).
\g@addto@macro\maketitle{\thispagestyle{fancy}}

\endinput
