\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Time helps according to the terminal task. Retained numerical optima for the two-state persistent chain \(a=1,c=1/2,g=w=1,z_0=0\). The top-only target is \(z_2(H)=1\). The full-apex target additionally requires \(z_1(H)=0\). Only the declared horizons \(H=2,3,4\) are plotted, with lines joining these samples as visual guides. At \(H=1\), both nonzero top tasks are unreachable, not zero-cost. The normalisation is \(E_0=1\) in illustrative squared-input units. No calibrated physical energy or uncertainty model is implied.}}{6}{figure.3}\protected@file@percent }
\newlabel{hrec:fig:effort}{{3}{6}{Time helps according to the terminal task. Retained numerical optima for the two-state persistent chain \(a=1,c=1/2,g=w=1,z_0=0\). The top-only target is \(z_2(H)=1\). The full-apex target additionally requires \(z_1(H)=0\). Only the declared horizons \(H=2,3,4\) are plotted, with lines joining these samples as visual guides. At \(H=1\), both nonzero top tasks are unreachable, not zero-cost. The normalisation is \(E_0=1\) in illustrative squared-input units. No calibrated physical energy or uncertainty model is implied}{figure.3}{}}
