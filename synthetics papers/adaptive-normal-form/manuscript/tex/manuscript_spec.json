        {
          "id": "lag",
          "label": "LAGGED: (m_k, theta_k)"
        },
        {
          "id": "lagplant",
          "label": "m_next = r m_k + (1-r) M(theta_k)"
        },
        {
          "id": "lagcontrol",
          "label": "theta_next = theta_k + alpha F'(theta_k) [m_k-F(theta_k)]"
        },
        {
          "id": "post",
          "label": "POST-OBSERVATION: (x_k, theta_k)"
        },
        {
          "id": "postplant",
          "label": "x_next = r x_k + (1-r) s theta_k"
        },
        {
          "id": "postcontrol",
          "label": "theta_next = theta_k + epsilon R(x_next-b theta_k)"
        }
      ],
      "edges": [
