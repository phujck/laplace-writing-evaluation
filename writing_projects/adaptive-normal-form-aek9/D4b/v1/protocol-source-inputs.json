  "faithful_source_snapshot": {
    "path": "synthetics papers/adaptive-normal-form/scripts/R5_check.py",
    "sha256": "8e74a837901bbf9149e857980ffa9b05c070e78e795b159fb8c62110dfd6a445",
    "offset": 1908,
    "end_offset": 3385,
    "units": "Unicode characters",
    "text": "def cascade_A(L):\n    \"\"\"Reconfiguration cascade: c on the first subdiagonal, input at the base.\"\"\"\n    A = np.zeros((L, L))\n    for i in range(1, L):\n        A[i, i - 1] = C_ATT\n    return A\n\ndef top_reachability(L, H):\n    \"\"\"e_L^T W_H e_L via the controllability Gramian over horizon H.\"\"\"\n    A = cascade_A(L)\n    B = np.zeros((L, 1)); B[0, 0] = 1.0\n    W = np.zeros((L, L))\n    At = np.eye(L)               # At = A^t, starting at t=0\n    for _ in range(H):\n        W += At @ B @ B.T @ At.T  # accumulate A^t B B^T (A^T)^t\n        At = A @ At               # advance to A^{t+1}\n    return W[L - 1, L - 1]\n\ndef energy_via_control_law(L, H):\n    \"\"\"Independent route: min-energy reconfiguration via the controllability matrix\n    pseudo-inverse. E_min = || u* ||^2 for a unit displacement at the top.\"\"\"\n    A = cascade_A(L)\n    B = np.zeros((L, 1)); B[0, 0] = 1.0\n    # controllability matrix over horizon H: [A^{H-1}B, ..., AB, B]\n    cols = []\n    Ai = np.eye(L)\n    powers = [np.eye(L)]\n    for _ in range(1, H):\n        powers.append(powers[-1] @ A)\n    for t in range(H):\n        cols.append((powers[t] @ B).flatten())\n    Cmat = np.column_stack(cols)          # L x H\n    target = np.zeros(L); target[L - 1] = 1.0\n    # minimum-norm u with Cmat @ u = target; infeasible if target not in range\n    u, *_ = np.linalg.lstsq(Cmat, target, rcond=None)\n    residual = np.linalg.norm(Cmat @ u - target)\n    if residual > 1e-8:\n        return np.inf\n    return float(u @ u)\n\n",
    "use": "Readable source-input mapping, not imported/executed original module with its plotting/sweep side effects. New general A=aI+cS reduces to exact cascade_A at a0,c=C_ATT,g1."
  },
  "model": {
    "update": "x[t+1]=A x[t]+B u[t], A=aI+cS,B=g e1, top=ell x with ell=eL^T",
    "convention": "u chronological t0..H-1, C=[A^(H-1)B,...,B]. Original R5 ascending-powers columns permute chronology but preserve norm/reachability.",
    "metric": "J=u^T diag(weights)u. Uniform w unless explicitly overridden.",
    "units": "Dimensionless illustrative state/input and chosen squared-input effort units, k/t update count. Not heat or physical calibration.",
    "default_initial": "zero",
    "output_vs_full": "top delta versus full delta eL is fair nested task. full ones is a separate vector with same top."
  },
