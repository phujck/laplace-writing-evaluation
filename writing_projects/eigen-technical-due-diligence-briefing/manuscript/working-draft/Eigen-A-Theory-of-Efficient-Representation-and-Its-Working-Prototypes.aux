\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces What the coarse state omits. Four states exchange probability at the labelled symmetric rates. Starting in state 1 or 2 gives $p_A(0)=1$, but initial rates $-1$ and $-3$. Retaining $z=(p_1-p_2)-(p_3-p_4)$ closes the prediction for $y=p_A-p_B$, with $\dot  y=-4y+2z$ and $\dot  z=2y-12z$. Eliminating $z$ gives an exact memory term instead. This constructed example makes the retention and residual mechanisms explicit.}}{6}{figure.caption.3}\protected@file@percent }
\newlabel{fig:dd-retention-memory}{{3}{6}{What the coarse state omits. Four states exchange probability at the labelled symmetric rates. Starting in state 1 or 2 gives $p_A(0)=1$, but initial rates $-1$ and $-3$. Retaining $z=(p_1-p_2)-(p_3-p_4)$ closes the prediction for $y=p_A-p_B$, with $\dot y=-4y+2z$ and $\dot z=2y-12z$. Eliminating $z$ gives an exact memory term instead. This constructed example makes the retention and residual mechanisms explicit}{figure.caption.3}{}}
\newlabel{eq:reconstruction}{{11}{6}{What a summary must remember}{equation.3.11}{}}
