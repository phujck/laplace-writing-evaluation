\begin{tikzpicture}[x=1cm,y=1cm,font=\sffamily\small,line cap=round,line join=round]
\definecolor{ink}{HTML}{183449}\definecolor{blue}{HTML}{0072B2}\definecolor{teal}{HTML}{009E73}\definecolor{amber}{HTML}{D55E00}
\tikzset{read/.style={->,teal,line width=1.5pt},write/.style={->,blue,line width=1.5pt},edge/.style={ink!70,line width=.9pt}}

\node[anchor=west,font=\sffamily\bfseries] at (0,6.7) {An agent acts through the tools of its task};
\draw[edge,fill=blue!5,rounded corners=4pt] (.2,3.8) rectangle (2.3,5.5);
\draw[ink!35] (.5,5.05)--(1.9,5.05) (.5,4.7)--(1.65,4.7) (.5,4.35)--(1.8,4.35);
\node[font=\sffamily\footnotesize] at (1.25,5.85) {bounded context};
\draw[write] (2.4,4.5)--(3.45,4.5);
\begin{scope}[shift={(4.1,4.25)},scale=1.05]
\fill[ink!12] (0,-.65) ellipse (.62 and .12);
\draw[edge,fill=white,rounded corners=5pt] (-.48,-.42) rectangle (.48,.25);
\draw[edge,fill=blue!12,rounded corners=5pt] (-.58,.18) rectangle (.58,.85);
\draw[edge] (0,.85)--(0,1.08);\fill[amber] (0,1.12) circle (.08);
\fill[ink] (-.23,.54) circle (.065);\fill[ink] (.23,.54) circle (.065);
\draw[ink] (-.16,.33) .. controls (0,.22) .. (.16,.33);
\draw[edge,line width=2pt] (-.48,-.08)--(-.75,.08) (.48,-.08)--(.79,.28);
\draw[edge,line width=2pt] (-.24,-.42)--(-.3,-.59) (.24,-.42)--(.3,-.59);
\fill[teal] (0,-.06) circle (.09);
\end{scope}

\node[font=\sffamily\footnotesize] at (2.8,3.1) {choose a tool};
\draw[write] (5,4.5)--(6.1,4.5);
\draw[edge,fill=ink!5,rounded corners=3pt] (6.15,3.35) rectangle (7.15,5.8);
\draw[blue,line width=2pt] (6.4,3.8)--(6.4,5.3)--(6.9,5.3)--(6.9,3.8);
\fill[teal] (6.65,5.55) circle (.09);
\node[font=\sffamily\footnotesize,align=center] at (6.65,2.85) {role and\\scope gate};
\draw[write] (7.15,4.5)--(8.25,4.5);
\begin{scope}[shift={(8.5,3.7)},scale=1.1]
\draw[edge,fill=blue!6,rounded corners=3pt] (0,0) rectangle (2.5,1.65);
\draw[edge,fill=white] (.25,.38)--(.25,1.42)--(1.02,1.42)--(1.2,1.22)--(1.2,.38)--cycle;
\draw[ink!35] (.42,1.08)--(.99,1.08) (.42,.87)--(.99,.87) (.42,.66)--(.84,.66);
\draw[edge,fill=white] (1.38,.38) rectangle (2.25,1.35);
\draw[teal,line width=1.1pt] (1.51,.59)--(1.69,.94)--(1.87,.72)--(2.1,1.13);
\draw[edge,fill=blue!20] (0,0)--(0,.55)--(1.25,.2)--(2.5,.55)--(2.5,0)--cycle;
\fill[teal] (2.5,1.18) circle (.08);\fill[blue] (2.5,.62) circle (.08);
\end{scope}

\node[font=\sffamily\footnotesize] at (9.85,5.95) {owner checks and changes};
\draw[read] (11.35,4.5)--(12.3,4.5)--(12.3,2.15);
\draw[edge,fill=teal!6,rounded corners=4pt] (11.25,.9) rectangle (13.35,2.1);
\node[font=\sffamily\footnotesize,align=center] at (12.3,1.5) {result\\and receipt};
\draw[read] (11.2,1.5)--(8.25,1.5);
\draw[edge,fill=white] (7.5,2.15) circle (.32);
\draw[edge,fill=amber!12,rounded corners=6pt] (6.95,.85) rectangle (8.05,1.75);
\node[font=\sffamily\footnotesize,align=center] at (7.5,.25) {human / parent\\judgement};
\draw[amber,->,line width=1.4pt] (6.9,1.5)--(4.1,1.5)--(4.1,3.5);
\node[font=\sffamily\footnotesize,fill=white] at (5.3,1.8) {inspect and revise};


