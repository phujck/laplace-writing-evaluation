\begin{tikzpicture}[x=1cm,y=1cm,font=\rmfamily\small]
\definecolor{ink}{HTML}{203340}
\definecolor{blue}{HTML}{0072B2}
\definecolor{teal}{HTML}{009E73}
\definecolor{amber}{HTML}{D55E00}
\tikzset{state/.style={circle,draw=blue,fill=blue!7,minimum size=8mm,line width=0.9pt},head/.style={font=\rmfamily\bfseries,color=ink},box/.style={draw=teal,fill=teal!4,rounded corners=2mm,line width=0.8pt,align=center}}
\node[head,anchor=west] at (0,4.3) {1. The process};
\node[state] (a) at (0.7,3.3) {1};
\node[state] (b) at (0.7,1.6) {2};
\node[state] (c) at (3.1,3.3) {3};
\node[state] (d) at (3.1,1.6) {4};
\draw[<->,line width=1pt,ink] (a)--node[left]{4}(b);
\draw[<->,line width=1pt,ink] (c)--node[right]{4}(d);
\draw[<->,line width=1pt,ink] (a)--node[above]{1}(c);
\draw[<->,line width=1.8pt,amber] (b)--node[below]{3}(d);
\draw[blue,dashed,rounded corners] (0,0.9) rectangle (1.4,3.9);
\draw[teal,dashed,rounded corners] (2.4,0.9) rectangle (3.8,3.9);
\node[color=blue] at (0.7,0.5) {Region A};
\node[color=teal] at (3.1,0.5) {Region B};
\node[align=center,text width=3.9cm,color=ink,anchor=north] at (1.9,0.1) {Predict the mass in A.\\Rates: inverse time units.};
\draw[gray!35] (4.3,-0.7)--(4.3,4.4);
\node[head,anchor=west] at (4.7,4.3) {2. What is lost?};
\node[box,draw=blue,text width=3.1cm,minimum height=1cm] at (6.35,3.2) {Both starting states give\\$p_A=1,\quad p_B=0$};
\node[align=center,text width=3.3cm,color=ink] at (6.35,1.85) {Start in 1: $p_A'(0)=-1$\\[3mm]Start in 2: $p_A'(0)=-3$};
\node[align=center,text width=3.4cm,color=amber] at (6.35,0.3) {Same coarse state,\\different futures.};
\draw[gray!35] (8.4,-0.7)--(8.4,4.4);
\node[head,anchor=west] at (8.8,4.3) {3. Recover the future};
\node[box,text width=4.2cm,minimum height=1.6cm] at (11,2.9) {Keep one imbalance $z$\\[2mm]$y'=-4y+2z$\\$z'=2y-12z$};
\draw[->,teal,line width=1pt] (11,1.95)--(11,1.7);
\node[align=center,text width=4.4cm,color=ink,anchor=north] at (11,1.6) {Or eliminate $z$ and retain its history:\\[2mm]$y'=-4y+2e^{-12t}z(0)$\\[1mm]$\displaystyle\quad+4\int_0^t e^{-12(t-s)}y(s)\,ds$};
\end{tikzpicture}