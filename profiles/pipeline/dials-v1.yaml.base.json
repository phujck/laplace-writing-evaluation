 "loop": {
  "max_rounds": 4,
  "weld": "auto",
  "weld_global_dirty_threshold": 4,
  "lock": {
   "readers": [
    "R1",
    "R2",
    "R4",
    "R5",
    "R6",
    "R7",
    "R9",
    "R10"
   ],
   "voice_wash": true
  },
  "verify_votes": 1
 },
 "drift": {
  "page_change_warn": 3,
  "page_count_change": "loud"
 },
 "suppression": {
  "key": [
   "node",
   "kind",
   "fingerprint"
  ],
  "stale_on_fingerprint_mismatch": true
 },
 "fanout": {
  "max_width": 0,
  "batch_max_chars": 140000
 },
 "stores": {
  "paragraph_plan": {
   "enabled": true
  },
  "section_architecture": {
   "enabled": false
  },
  "spine_chain": {
   "enabled": false
  },
  "derivation_walk": {
   "enabled": false
  },
  "figure_caption": {
   "enabled": false
  }
 },
 "prompts": {
  "overrides_dir": "profiles/pipeline/prompts"
 }
}